---
import Base from '../layouts/Base.astro';
import { nonProBooks, withBase } from '../lib/data';

interface NonPro {
  id: string;
  title: string;
  subtitle: string;
  description: string;
  url: string;
}
const books = nonProBooks as unknown as NonPro[];
---

<Base title="程序员应有的非编程书籍" description="上游精选的程序员非编程类阅读书单">
  <div class="crumbs"><a href={withBase('/')}>首页</a> / 非编程好书</div>
  <h1 class="page-title">程序员应有的非编程书籍</h1>
  <p class="page-sub">
    来自上游
    <a href="https://github.com/justjavac/free-programming-books-zh_CN/blob/main/what-non-programming-books-should-programmers-read.md" target="_blank" rel="noopener">what-non-programming-books-should-programmers-read.md</a>
    的精选书单,多为出版书籍,附介绍与购买/参考链接。
  </p>

  <div class="book-list">
    {books.map((b) => (
      <div class="book-card">
        <span class="t">{b.title}</span>
        {b.subtitle && <span class="d" style="margin-left:8px">{b.subtitle}</span>}
        {b.url && <span> <a class="d" href={b.url} target="_blank" rel="noopener">参考链接 ↗</a></span>}
        {b.description && <div class="d">{b.description}…</div>}
      </div>
    ))}
  </div>
</Base>
